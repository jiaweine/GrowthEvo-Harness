# Copy this file to .env before running Docker Compose.
# .env is gitignored. Fill the required database values before starting the stack.

GROWTHEVO_POSTGRES_USER=growthevo
GROWTHEVO_POSTGRES_PASSWORD=
GROWTHEVO_POSTGRES_DB=growthevo
# Set this after choosing the password above. URL-encode reserved URL characters.
GROWTHEVO_DATABASE_URL=
GROWTHEVO_DB_POOL_MIN_SIZE=1
GROWTHEVO_DB_POOL_MAX_SIZE=8
GROWTHEVO_DB_POOL_TIMEOUT_SECONDS=5

# `api` is a durable reference runtime for local/self-host validation.
# Switch to `production` only after the OIDC values below are configured.
GROWTHEVO_MODE=api
GROWTHEVO_ENV=self-hosted
GROWTHEVO_API_BIND=127.0.0.1
GROWTHEVO_API_PORT=8765
GROWTHEVO_CORS_ORIGINS=

# Required together for production mode. The API remains fail-closed without them.
GROWTHEVO_AUTH_ISSUER=
GROWTHEVO_AUTH_JWKS_URL=
GROWTHEVO_AUTH_AUDIENCE=

# Explicit process/request admission controls. GrowthEvo intentionally ignores
# hosting-platform WEB_CONCURRENCY unless you opt in here because every worker
# owns an independent database pool and LLM provider pool.
GROWTHEVO_WEB_WORKERS=1
GROWTHEVO_HTTP_LIMIT_CONCURRENCY=512
GROWTHEVO_HTTP_GRACEFUL_SHUTDOWN_SECONDS=55

# Optional guarded LLM activation. Each route needs both key + pinned model.
GROWTHEVO_LLM_ROUTES=
OPENAI_API_KEY=
GROWTHEVO_OPENAI_MODEL=
ANTHROPIC_API_KEY=
GROWTHEVO_ANTHROPIC_MODEL=
GEMINI_API_KEY=
GROWTHEVO_GEMINI_MODEL=
GROWTHEVO_LLM_TIMEOUT_SECONDS=45
GROWTHEVO_LLM_MAX_RETRIES=2
GROWTHEVO_LLM_MAX_CONCURRENCY=64
GROWTHEVO_LLM_MAX_QUEUE_SIZE=256
GROWTHEVO_LLM_ACQUIRE_TIMEOUT_SECONDS=1
GROWTHEVO_LLM_FAILURE_THRESHOLD=3
GROWTHEVO_LLM_COOLDOWN_SECONDS=30
GROWTHEVO_LLM_MAX_PROVIDER_ATTEMPTS=2
