# Copy this file to .env before running Docker Compose.
# .env is gitignored. Replace every example secret before exposing the service.

GROWTHEVO_POSTGRES_USER=growthevo
GROWTHEVO_POSTGRES_PASSWORD=replace-with-a-long-random-password
GROWTHEVO_POSTGRES_DB=growthevo
# URL-encode the password below if it contains reserved URL characters.
GROWTHEVO_DATABASE_URL=postgresql://growthevo:replace-with-a-long-random-password@postgres:5432/growthevo

# `api` is a durable reference runtime for local/self-host validation.
# Switch to `production` only after the OIDC values below are configured.
GROWTHEVO_MODE=api
GROWTHEVO_ENV=self-hosted
GROWTHEVO_API_BIND=127.0.0.1
GROWTHEVO_API_PORT=8765
GROWTHEVO_CORS_ORIGINS=

# Required together for production mode. The API remains fail-closed without them.
GROWTHEVO_AUTH_ISSUER=
GROWTHEVO_AUTH_JWKS_URL=
GROWTHEVO_AUTH_AUDIENCE=
