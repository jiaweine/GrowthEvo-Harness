name: Product Surface CI

on:
  push:
    paths:
      - "growthevo/web/**"
      - "apps/mobile/**"
      - "constraints/web-container-py313.txt"
      - "Dockerfile"
      - ".dockerignore"
      - "scripts/build_pages.py"
      - "scripts/browser_product_check.py"
      - "scripts/stress_product.py"
      - "scripts/stress_decision_semantics.py"
      - "tests/test_dashboard.py"
      - "tests/test_product_*.py"
      - "docs/product_surface.md"
      - "docs/deployment_architecture.md"
      - "docs/performance_testing.md"
      - "pyproject.toml"
      - ".github/workflows/product-surface.yml"
  pull_request:
    paths:
      - "growthevo/web/**"
      - "apps/mobile/**"
      - "constraints/web-container-py313.txt"
      - "Dockerfile"
      - ".dockerignore"
      - "scripts/build_pages.py"
      - "scripts/browser_product_check.py"
      - "scripts/stress_product.py"
      - "scripts/stress_decision_semantics.py"
      - "tests/test_dashboard.py"
      - "tests/test_product_*.py"
      - "docs/product_surface.md"
      - "docs/deployment_architecture.md"
      - "docs/performance_testing.md"
      - "pyproject.toml"
      - ".github/workflows/product-surface.yml"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  web-product:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7
        with:
          python-version: "3.13"
          cache: pip
          cache-dependency-path: |
            pyproject.toml
            constraints/web-container-py313.txt
      - name: Install production-aligned web product dependencies
        run: python -m pip install --constraint constraints/web-container-py313.txt -e '.[web,dev]'
      - name: Run web product tests
        run: >-
          pytest
          tests/test_dashboard.py
          tests/test_product_surface.py
          tests/test_product_api.py
          tests/test_product_configuration.py
          tests/test_product_runtime_environment_safety.py
          tests/test_product_openapi_contract.py
          tests/test_product_concurrency.py
          tests/test_product_release_identity.py
      - name: Check browser JavaScript syntax
        run: |
          for file in growthevo/web/static/*.js; do
            node --check "$file"
          done
      - name: Build production container
        run: docker build -t growthevo-api:ci .
      - name: Smoke and stress the same production container
        shell: bash
        run: |
          set -euo pipefail
          docker run --rm -d --name growthevo-api-ci -p 8765:8765 \
            -e GROWTHEVO_MODE=api \
            -e GROWTHEVO_ENV=ci-container \
            growthevo-api:ci
          trap 'docker rm -f growthevo-api-ci >/dev/null 2>&1 || true' EXIT
          for attempt in $(seq 1 30); do
            if curl --fail --silent http://127.0.0.1:8765/api/ready >/dev/null; then
              break
            fi
            if [[ "$attempt" == "30" ]]; then
              docker logs growthevo-api-ci
              exit 1
            fi
            sleep 1
          done
          curl --fail --silent http://127.0.0.1:8765/api/health
          mkdir -p stress-reports
          python scripts/stress_product.py \
            --base-url http://127.0.0.1:8765 \
            --profile ci \
            --json-out stress-reports/product-stress-ci.json \
            --markdown-out stress-reports/product-stress-ci.md
          python scripts/stress_decision_semantics.py \
            --base-url http://127.0.0.1:8765 \
            --profile ci \
            > stress-reports/decision-semantics-ci.json
          cat stress-reports/decision-semantics-ci.json
      - name: Upload product stress report
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: growthevo-product-stress-ci
          path: stress-reports/*
          if-no-files-found: warn
      - name: Build GitHub Pages demo artifact
        run: |
          python scripts/build_pages.py --out site
          test -f site/index.html
          test -f site/config.js
          test -f site/product-pages.css
          test -f site/runtime-ui.js
          test -f site/product-data.js
          test -f site/product-advanced-data.js
          test -f site/live-pages.js
          test -f site/service-worker.js
          grep -q "GrowthEvo" site/index.html
          grep -q 'MODE: "demo"' site/config.js
          grep -q 'Demo Workspace' site/runtime-ui.js
      - name: Check Pages artifact JavaScript
        run: |
          for file in site/*.js; do
            node --check "$file"
          done
      - name: Install CJK fonts for deterministic screenshots
        run: |
          sudo apt-get update
          sudo apt-get install -y fonts-noto-cjk
      - name: Capture real rendered demo UI screenshots
        run: |
          python -m pip install 'playwright==1.55.0'
          python -m playwright install --with-deps chromium
          python -m http.server 4173 --directory site > /tmp/growthevo-pages.log 2>&1 &
          PAGES_PID=$!
          trap 'kill $PAGES_PID || true' EXIT
          for attempt in $(seq 1 30); do
            if curl --fail --silent http://127.0.0.1:4173/ >/dev/null; then
              break
            fi
            if [[ "$attempt" == "30" ]]; then
              cat /tmp/growthevo-pages.log
              exit 1
            fi
            sleep 1
          done
          python scripts/render_product_screenshots.py \
            --base-url http://127.0.0.1:4173 \
            --out screenshots
      - name: Exercise API-mode workbenches in real Chrome
        shell: bash
        run: |
          set -euo pipefail
          rm -rf site-api
          GROWTHEVO_API_BASE=http://127.0.0.1:8766 python scripts/build_pages.py --out site-api
          grep -q 'MODE: "api"' site-api/config.js
          grep -q 'API_BASE: "http://127.0.0.1:8766"' site-api/config.js
          docker run --rm -d --name growthevo-api-browser -p 8766:8765 \
            -e GROWTHEVO_MODE=api \
            -e GROWTHEVO_ENV=browser-ci \
            -e GROWTHEVO_CORS_ORIGINS=http://127.0.0.1:4174 \
            growthevo-api:ci
          API_CONTAINER=growthevo-api-browser
          PAGES_PID=""
          cleanup_browser_ci() {
            [[ -z "$PAGES_PID" ]] || kill "$PAGES_PID" >/dev/null 2>&1 || true
            [[ -z "$API_CONTAINER" ]] || docker rm -f "$API_CONTAINER" >/dev/null 2>&1 || true
          }
          trap cleanup_browser_ci EXIT
          for attempt in $(seq 1 30); do
            if curl --fail --silent http://127.0.0.1:8766/api/ready >/dev/null; then
              break
            fi
            if [[ "$attempt" == "30" ]]; then
              docker logs growthevo-api-browser
              exit 1
            fi
            sleep 1
          done
          python -m http.server 4174 --directory site-api > /tmp/growthevo-pages-api.log 2>&1 &
          PAGES_PID=$!
          for attempt in $(seq 1 30); do
            if curl --fail --silent http://127.0.0.1:4174/ >/dev/null; then
              break
            fi
            if [[ "$attempt" == "30" ]]; then
              cat /tmp/growthevo-pages-api.log
              exit 1
            fi
            sleep 1
          done
          python scripts/browser_product_check.py \
            --base-url http://127.0.0.1:4174 \
            --expect-api-base http://127.0.0.1:8766 \
            --expect-action free_shipping
          docker rm -f "$API_CONTAINER"
          API_CONTAINER=""
          python - <<'PY'
          from __future__ import annotations

          import asyncio

          from playwright.async_api import async_playwright

          BASE_URL = "http://127.0.0.1:4174"


          async def main() -> None:
              async with async_playwright() as playwright:
                  browser = await playwright.chromium.launch(headless=True)
                  page = await browser.new_page(viewport={"width": 1536, "height": 1024})
                  response = await page.goto(BASE_URL, wait_until="networkidle")
                  assert response is not None and response.ok, response
                  await page.wait_for_selector("[data-api-unavailable]", state="visible")
                  text = await page.locator("[data-api-unavailable]").inner_text()
                  body = await page.locator("body").inner_text()
                  assert "GrowthEvo API 暂不可用" in text
                  assert "Demo Workspace" not in body
                  assert "Synthetic Data" not in body
                  assert "Reference UI Fixture" not in body
                  await browser.close()


          asyncio.run(main())
          PY
      - name: Upload rendered UI screenshots
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7
        with:
          name: growthevo-product-screenshots
          path: screenshots/*.png

  mobile:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
        with:
          node-version: "24"
          cache: npm
          cache-dependency-path: apps/mobile/package-lock.json
      - name: Install locked mobile dependencies
        working-directory: apps/mobile
        run: npm ci
      - name: Typecheck
        working-directory: apps/mobile
        run: npm run typecheck
